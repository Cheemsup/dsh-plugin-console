{
  "name": "@cheemsup/dsh-plugin-console",
  "version": "0.3.7",
  "description": "插件运行控制台：观测当前 profile 的插件组合、会话来源、工具归属与首请求，并支持会话级提示词/工具定制",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.styles.js",
    "lib/client.shared.js",
    "lib/client.workspace-picker.js",
    "lib/client.search.js",
    "lib/client.plugins.js",
    "lib/client.plugin-detail.js",
    "lib/client.surface.js",
    "lib/client.surface-store.js",
    "lib/client.surface-skills.js",
    "lib/client.surface-commands.js",
    "lib/client.surface-network.js",
    "lib/client.plugin-filters.js",
    "lib/client.activity.js",
    "lib/client.changes.js",
    "lib/client.control.js",
    "lib/client.sessions.js",
    "lib/client.tools.js",
    "lib/client.preview.js",
    "lib/client.preview-raw.js",
    "lib/client.preview-store.js",
    "lib/client.preview-messages.js",
    "lib/client.preview-tools.js",
    "lib/client.effects.js",
    "lib/client.editor.js",
    "lib/client.draft.js",
    "lib/client.dialog.js",
    "lib/client.template-card.js",
    "lib/client.cleanup.js",
    "lib/client.influence.js",
    "lib/client.schema.js",
    "lib/client.apply.js",
    "lib/client.store.js",
    "lib/client.editor-store.js",
    "lib/client.editor-messages.js",
    "lib/client.page.js",
    "lib/client.session-detail.js",
    "lib/client.graph-layout.js",
    "lib/client.graph-net.js",
    "lib/client.graph-route.js",
    "lib/client.impact-tree.js",
    "lib/client.relation-graph.js",
    "lib/client.disable-preview.js",
    "lib/host/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "verify:host": "node --input-type=module -e \"import('./lib/index.js').then(() => console.log('host entry ok'))\"",
    "verify:health": "node scripts/verify-health.mjs",
    "verify:activity": "node scripts/verify-activity.mjs",
    "verify:changes": "node scripts/verify-changes.mjs",
    "verify:impact": "node scripts/verify-impact.mjs",
    "verify:patch-config": "node scripts/verify-patch-config.mjs",
    "verify:disable-preview": "node scripts/verify-disable-preview.mjs",
    "verify:session-plan": "node scripts/verify-session-plan.mjs",
    "verify:control": "node scripts/verify-control.mjs",
    "verify:snapshot": "node scripts/verify-host-snapshot.mjs",
    "verify:templates": "node scripts/verify-templates.mjs",
    "verify:materialize": "node scripts/verify-materialize.mjs",
    "verify:cleanup": "node scripts/verify-cleanup.mjs",
    "verify:session-influence": "node scripts/verify-session-influence.mjs",
    "verify:request-preview": "node scripts/verify-request-preview.mjs",
    "verify:source-scan": "node scripts/verify-source-scan.mjs",
    "verify:registration-site": "node scripts/verify-registration-site.mjs",
    "verify:imports": "node scripts/verify-imports.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:chunks": "node scripts/verify-chunks.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:icon": "node scripts/verify-icon.mjs",
    "verify:surface-skills": "node scripts/verify-surface-skills.mjs",
    "verify:surface-commands": "node scripts/verify-surface-commands.mjs",
    "verify:surface-network": "node scripts/verify-surface-network.mjs",
    "verify:views": "node scripts/verify-views.mjs",
    "verify:destructuring": "node scripts/verify-destructuring.mjs",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify": "npm run verify:host && npm run verify:health && npm run verify:activity && npm run verify:changes && npm run verify:impact && npm run verify:patch-config && npm run verify:disable-preview && npm run verify:session-plan && npm run verify:control && npm run verify:snapshot && npm run verify:templates && npm run verify:materialize && npm run verify:cleanup && npm run verify:session-influence && npm run verify:request-preview && npm run verify:source-scan && npm run verify:registration-site && npm run verify:imports && npm run verify:theme && npm run verify:chunks && npm run verify:bundle && npm run verify:icon && npm run verify:surface-skills && npm run verify:surface-commands && npm run verify:surface-network && npm run verify:views && npm run verify:destructuring && npm run verify:structure"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Cheemsup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cheemsup/dsh-plugin-console.git"
  },
  "homepage": "https://github.com/Cheemsup/dsh-plugin-console",
  "bugs": {
    "url": "https://github.com/Cheemsup/dsh-plugin-console/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin-console",
    "inspector",
    "prompt-preview"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
